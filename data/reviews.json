[
  { "id": "h_001", "entity_id": "hotel_001", "rating": 5, "created_at": "2024-09-03T10:00:00Z", "text": "離新宿站東口走路大概6分鐘，拖行李也還好。房間小但很乾淨。" },
  { "id": "h_002", "entity_id": "hotel_001", "rating": 2, "created_at": "2024-10-11T09:30:00Z", "text": "裝潢有點舊，浴室有霉味，冷氣聲音很大，晚上睡不太好。" },
  { "id": "h_003", "entity_id": "hotel_001", "rating": 4, "created_at": "2024-12-20T14:00:00Z", "text": "位置很好，樓下就有全家跟松屋，宵夜很方便。房間偏小，兩個大行李箱打不太開。" },
  { "id": "h_004", "entity_id": "hotel_001", "rating": 5, "created_at": "2025-02-14T08:10:00Z", "text": "" },
  { "id": "h_005", "entity_id": "hotel_001", "rating": 1, "created_at": "2025-03-02T22:00:00Z", "text": "真是太棒了，半夜冷氣壞掉熱到睡不著，櫃台說明天才能修。" },
  { "id": "h_006", "entity_id": "hotel_001", "rating": 5, "created_at": "2025-05-18T11:00:00Z", "text": "利木津巴士在附近飯店就有站，從成田過來很輕鬆。建議訂高樓層，低樓層聽得到街上的聲音。" },
  { "id": "h_007", "entity_id": "hotel_001", "rating": 4, "created_at": "2025-06-30T16:20:00Z", "text": "這個價位在新宿算很划算，床很好睡。附近居酒屋很多，晚上有點吵。" },
  { "id": "h_008", "entity_id": "hotel_001", "rating": 5, "created_at": "2025-08-09T09:00:00Z", "text": "讚" },
  { "id": "h_009", "entity_id": "hotel_001", "rating": 5, "created_at": "2025-09-21T13:40:00Z", "text": "加LINE領日本住宿折價券，每晚最低500元，私訊我 xyz123" },
  { "id": "h_010", "entity_id": "hotel_001", "rating": 4, "created_at": "2025-10-05T19:00:00Z", "text": "去年翻修過，房間跟浴室都很新，乾淨度沒話說。離地鐵新宿三丁目站也近。" },
  { "id": "h_011", "entity_id": "hotel_001", "rating": 5, "created_at": "2025-11-12T07:50:00Z", "text": "早餐種類不多但很好吃，8點以後人很多要排隊，建議早點去。" },
  { "id": "h_012", "entity_id": "hotel_001", "rating": 3, "created_at": "2025-12-01T21:15:00Z", "text": "隔音普通，隔壁講話聽得到。不過交通真的很方便，去哪都快。" },
  { "id": "h_013", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-01-08T10:30:00Z", "text": "從新宿站東口出來走路5分鐘，周圍很熱鬧，唐吉訶德走路2分鐘。" },
  { "id": "h_014", "entity_id": "hotel_001", "rating": 4, "created_at": "2026-02-19T15:00:00Z", "text": "房間不大但動線設計很好，行李可以收在床底下。價格合理。" },
  { "id": "h_015", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-03-25T12:00:00Z", "text": "櫃台可以寄放行李，退房後還能去逛街再回來拿，很貼心。建議先在官網會員價訂比較便宜。" },
  { "id": "h_016", "entity_id": "hotel_001", "rating": 2, "created_at": "2026-04-10T23:30:00Z", "text": "週末晚上樓下歌舞伎町方向很吵，凌晨還有人在路上喝醉大叫。" },
  { "id": "h_017", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-05-02T09:20:00Z", "text": "地點無敵，新宿站走路就到，買東西吃東西都很方便，CP值高。" },
  { "id": "h_018", "entity_id": "hotel_001", "rating": 4, "created_at": "2026-06-15T18:45:00Z", "text": "自駕的話飯店沒有停車場，要提前預約附近的特約停車場，一晚2500日圓。" },
  { "id": "h_019", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-07-04T08:00:00Z", "text": "床墊軟硬適中，枕頭有兩種可以選。附近有24小時超市很方便。" },
  { "id": "h_020", "entity_id": "hotel_001", "rating": 3, "created_at": "2026-07-28T20:10:00Z", "text": "暑假價格漲很多，跟淡季比起來就不太划算了。房間乾淨這點沒問題。" },
  { "id": "h_021", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-08-16T11:30:00Z", "text": "機場巴士下車走過來大概3分鐘，晚班機到也不怕。周邊拉麵店很多。" },
  { "id": "h_022", "entity_id": "hotel_001", "rating": 4, "created_at": "2026-09-03T14:25:00Z", "text": "建議訂面向內側的房型，比較安靜。浴室有獨立浴缸很難得。" },
  { "id": "h_023", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-09-27T10:00:00Z", "text": "" },
  { "id": "h_024", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-10-09T09:40:00Z", "text": "附近餐廳選擇超多，晚上逛完回來樓下還能買宵夜。離JR新宿站很近。" },
  { "id": "h_025", "entity_id": "hotel_001", "rating": 4, "created_at": "2026-10-22T17:30:00Z", "text": "房間偏小是東京常態，但乾淨、設備新，這個價錢可以接受。" },
  { "id": "h_026", "entity_id": "hotel_001", "rating": 2, "created_at": "2026-11-02T22:40:00Z", "text": "低樓層臨馬路，整晚都是車聲，換房也沒空房。下次會指定高樓層。" },
  { "id": "h_027", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-11-10T08:15:00Z", "text": "走路到新宿御苑大概10分鐘，早上去散步很舒服。周邊治安感覺還不錯。" },
  { "id": "h_028", "entity_id": "hotel_001", "rating": 4, "created_at": "2026-11-18T12:00:00Z", "text": "入住時間是下午3點，提早到可以先寄行李。建議早餐8點前去比較不用排。" },

  { "id": "t_001", "entity_id": "tour_001", "rating": 5, "created_at": "2024-11-02T18:00:00Z", "text": "河口湖看到富士山倒映在湖面，天氣好時超美。導遊講解很用心。" },
  { "id": "t_002", "entity_id": "tour_001", "rating": 3, "created_at": "2025-01-19T17:00:00Z", "text": "週末人太多了，大石公園的拍照點要排隊，富士山拍照很難。建議平日去。" },
  { "id": "t_003", "entity_id": "tour_001", "rating": 5, "created_at": "2025-03-08T16:30:00Z", "text": "搭河口湖纜車上展望台，富士山全景很清楚，小孩很開心。導遊把富士山的由來講得很清楚。" },
  { "id": "t_004", "entity_id": "tour_001", "rating": 4, "created_at": "2025-04-27T15:00:00Z", "text": "接駁車準時，司機開山路很穩。中間休息時間有點趕。" },
  { "id": "t_005", "entity_id": "tour_001", "rating": 2, "created_at": "2025-06-14T19:20:00Z", "text": "下大雨，富士山完全被雲遮住，什麼都看不到，行程也沒有雨備方案。" },
  { "id": "t_006", "entity_id": "tour_001", "rating": 5, "created_at": "2025-08-03T17:45:00Z", "text": "" },
  { "id": "t_007", "entity_id": "tour_001", "rating": 5, "created_at": "2025-09-20T16:00:00Z", "text": "導遊會講富士山的信仰與江戶時代富士講的故事，還有忍野八海的湧泉由來，很有深度。" },
  { "id": "t_008", "entity_id": "tour_001", "rating": 4, "created_at": "2025-11-11T18:10:00Z", "text": "建議穿好走的鞋，忍野八海跟展望台階梯很多，膝蓋不好的人會有點辛苦。" },
  { "id": "t_009", "entity_id": "tour_001", "rating": 5, "created_at": "2026-01-25T15:30:00Z", "text": "大石公園那個角度拍富士山最美，導遊帶我們去人比較少的拍照點。" },
  { "id": "t_010", "entity_id": "tour_001", "rating": 1, "created_at": "2026-02-28T20:00:00Z", "text": "集合時間延誤40分鐘，也沒人通知，接駁車很擠。" },
  { "id": "t_011", "entity_id": "tour_001", "rating": 5, "created_at": "2026-04-12T17:20:00Z", "text": "清晨出發的梯次最容易看到富士山，建議選早上出發。整體很好玩。" },
  { "id": "t_012", "entity_id": "tour_001", "rating": 4, "created_at": "2026-05-30T16:40:00Z", "text": "冬天河口湖很冷又常起霧，記得帶外套跟手套。纜車站有寄物櫃。" },
  { "id": "t_013", "entity_id": "tour_001", "rating": 5, "created_at": "2026-07-19T18:00:00Z", "text": "景色真的很漂亮，富士山跟湖一起看到，氣氛很棒。" },
  { "id": "t_014", "entity_id": "tour_001", "rating": 3, "created_at": "2026-08-23T17:10:00Z", "text": "周邊商店重複性高，吃的偏貴。導遊人很好，接駁也準時。" },
  { "id": "t_015", "entity_id": "tour_001", "rating": 5, "created_at": "2026-09-14T16:20:00Z", "text": "忍野八海的湧泉很特別，水清澈見底，可以了解富士山融雪伏流的過程。" },
  { "id": "t_016", "entity_id": "tour_001", "rating": 4, "created_at": "2026-10-04T15:50:00Z", "text": "纜車遇到強風會停駛，報名前要確認天氣預報。整體行程安排順暢。" },
  { "id": "t_017", "entity_id": "tour_001", "rating": 5, "created_at": "2026-10-26T17:30:00Z", "text": "推推推" },
  { "id": "t_018", "entity_id": "tour_001", "rating": 5, "created_at": "2026-11-15T18:20:00Z", "text": "導遊很專業，會提醒注意事項，也會幫大家拍照。富士山加上河口湖遊船，完美的一天。" },
  { "id": "h_x01", "entity_id": "hotel_001", "rating": 1, "created_at": "2026-11-19T01:10:00Z", "text": "櫃台那個白痴態度超差，這種爛飯店倒一倒算了，垃圾中的垃圾！" },
  { "id": "h_x02", "entity_id": "hotel_001", "rating": 1, "created_at": "2026-11-19T02:20:00Z", "text": "白痴飯店，隔音爛到爆，隔壁講話跟打呼都聽得一清二楚，根本睡不著。" },
  { "id": "h_x03", "entity_id": "hotel_001", "rating": 1, "created_at": "2026-11-19T03:30:00Z", "text": "全世界最爛的飯店，永遠不會再來，大家千萬別住，老闆該去死。" },
  { "id": "h_x04", "entity_id": "hotel_001", "rating": 3, "created_at": "2026-11-19T04:40:00Z", "text": "還行" },
  { "id": "h_x05", "entity_id": "hotel_001", "rating": 4, "created_at": "2026-11-19T05:50:00Z", "text": "ok" },
  { "id": "h_x06", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-11-19T06:00:00Z", "text": "👍👍👍" },
  { "id": "h_x07", "entity_id": "hotel_001", "rating": 3, "created_at": "2026-11-19T07:10:00Z", "text": "就普通飯店，住了一晚，跟其他地方差不多吧，沒什麼特別的。" },
  { "id": "h_x08", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-11-19T08:20:00Z", "text": "好好好好好好好好好好好好好好好好好好好好" },
  { "id": "h_x09", "entity_id": "hotel_001", "rating": 5, "created_at": "2026-11-19T09:30:00Z", "text": "今天天氣真好，推薦大家去吃一蘭拉麵，順便買藥妝。" },
  { "id": "h_x10", "entity_id": "hotel_001", "rating": 1, "created_at": "2026-11-19T10:40:00Z", "text": "你們這些給好評的都是業配吧，一群智障，收了多少錢？" }
]
